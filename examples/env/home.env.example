# MQTT / Zigbee2MQTT / home telemetry settings.

ZAIK_MQTT_ENABLED=true
ZAIK_MQTT_HOST=localhost
ZAIK_MQTT_PORT=1883
ZAIK_MQTT_CLIENT_ID=zaik

# Zigbee2MQTT data directory. Adjust for your install.
ZAIK_ZIGBEE2MQTT_DATA_DIR=$HOME/.local/share/zigbee2mqtt/data

# SQLite telemetry stores.
ZAIK_TELEMETRY_ENABLED=true
ZAIK_TELEMETRY_DB=$HOME/.zaik/zaik.db
ZAIK_HOME_HISTORY_ENABLED=true
ZAIK_HOME_HISTORY_DB=$HOME/.zaik/home/home.db
# Durable evidence-backed per-entity/per-capability adapter semantics.
ZAIK_HOME_ADAPTER_CALIBRATIONS_ENABLED=true
# Defaults to ZAIK_HOME_HISTORY_DB when omitted.
# ZAIK_HOME_ADAPTER_CALIBRATIONS_DB=$HOME/.zaik/home/home.db

# Deterministic local environment context. Latitude/longitude enable calculated
# sunrise/sunset; configured hours remain the fallback. Keep the explicit UTC
# offset synchronized with daylight-saving changes until a timezone database
# adapter is configured.
ZAIK_HOME_TIMEZONE=America/New_York
# ZAIK_HOME_LOCATION_NAME=Home
# ZAIK_HOME_LATITUDE=40.7128
# ZAIK_HOME_LONGITUDE=-74.0060
# ZAIK_HOME_UTC_OFFSET_MINUTES=-240
ZAIK_HOME_HEMISPHERE=north
ZAIK_HOME_DAY_START_HOUR=6
ZAIK_HOME_NIGHT_START_HOUR=20

# Presence alert rules. Default cooldown is 15 minutes to avoid notification spam.
ZAIK_ALERTS_ENABLED=true
ZAIK_ALERTS_PATH=$HOME/.zaik/alerts/rules.json
ZAIK_ALERT_DEFAULT_COOLDOWN_SECONDS=900

# Optional staged-plan watchdog delivery. Disabled by default and read-only:
# it can notify operators but cannot execute, retry, or cancel plans.
ZAIK_HOME_STAGED_ALERTS_ENABLED=false
# ZAIK_HOME_STAGED_ALERT_CHAT_ID=telegram-chat-id
ZAIK_HOME_STAGED_ALERT_INTERVAL_SECONDS=60
ZAIK_HOME_STAGED_ALERT_COOLDOWN_SECONDS=900
ZAIK_HOME_STAGED_ALERT_TASK_TIMEOUT_MS=10000
