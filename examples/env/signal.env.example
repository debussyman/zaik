# Optional legacy Signal adapter via signal-cli.
# Telegram is the preferred multi-user chat adapter.
# Copy to ~/.config/zaik/signal.env and chmod 600 if you use Signal.

ZAIK_SIGNAL_ENABLED=false
ZAIK_SIGNAL_MODE=cli
ZAIK_SIGNAL_ACCOUNT=+15555555555
ZAIK_SIGNAL_ALLOWED_SENDERS=+15555555555
ZAIK_SIGNAL_POLL_INTERVAL_MS=5000
