# Pluggable local LLM provider settings.
# These can live in ~/.config/zaik/telegram.env, ~/.config/zaik/llm.env,
# or any EnvironmentFile loaded by your service manager.

# Ollama provider
ZAIK_LLM_PROVIDER=ollama
ZAIK_OLLAMA_URL=http://127.0.0.1:11434
ZAIK_LLM_MODEL=qwen3-coder:30b

# llama.cpp / llama-server provider
# ZAIK_LLM_PROVIDER=llama_cpp
# ZAIK_LLAMA_CPP_URL=http://127.0.0.1:8080
# ZAIK_LLM_MODEL=qwen3-coder:30b

# AgentChat can use separate primary/fallback models.
ZAIK_AGENT_MODEL=qwen3:4b-instruct
ZAIK_AGENT_FALLBACK_ENABLED=true
ZAIK_AGENT_FALLBACK_MODEL=qwen3.8:27b

# Deprecated legacy parser; normal free-form chat does not use this path.
ZAIK_INTENT_ENABLED=false
